PORT=3001
# Comma-separated origins. Example: http://localhost:8081
# If omitted, CORS will allow all origins (dev-friendly).
CORS_ORIGIN=http://localhost:8081,http://localhost:8080

# OpenAI (server-side only)
OPENAI_API_KEY=your_key_here
# Optional, example: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# JWT auth
# Generate a long random secret for production.
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/radiant_emotions

